<UserControl x:Class="Vktun.IoT.Connector.Client.Views.ModbusSlaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Padding="10">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Modbus TCP Slave" Style="{StaticResource CardGroupBox}">
            <WrapPanel>
                <TextBlock Text="Listen:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding ListenAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="130"/>
                <TextBlock Text="Port:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="80"/>
                <TextBlock Text="Slave:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="60"/>
                <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Width="80"/>
                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Width="80"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Data Store" Style="{StaticResource CardGroupBox}" Margin="10,0">
            <WrapPanel>
                <TextBlock Text="Coils:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding CoilCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="70"/>
                <TextBlock Text="Discrete:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding DiscreteInputCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="70"/>
                <TextBlock Text="Input Regs:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding InputRegisterCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="70"/>
                <TextBlock Text="Holding:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding HoldingRegisterCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="70"/>
                <TextBlock Text="Area:" Style="{StaticResource LabelTextBlock}"/>
                <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Style="{StaticResource InputComboBox}" Width="150"/>
                <TextBlock Text="Address:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="70"/>
                <TextBlock Text="Value:" Style="{StaticResource LabelTextBlock}"/>
                <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}" Width="100"/>
                <Button Content="Set" Command="{Binding SetValueCommand}" Style="{StaticResource PrimaryButton}" Width="70"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Width="90"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Live Data" Style="{StaticResource CardGroupBox}" Margin="10,0">
            <DataGrid ItemsSource="{Binding DataRows}" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="160"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Traffic" Style="{StaticResource CardGroupBox}" Margin="10,0">
            <DataGrid ItemsSource="{Binding TrafficRows}" Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="100"/>
                    <DataGridTextColumn Header="Client" Binding="{Binding ClientEndPoint}" Width="150"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitId}" Width="60"/>
                    <DataGridTextColumn Header="FC" Binding="{Binding FunctionCode}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="Tx" Binding="{Binding Request}" Width="260"/>
                    <DataGridTextColumn Header="Rx" Binding="{Binding Response}" Width="260"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Log" Style="{StaticResource CardGroupBox}" Margin="10,0,10,10">
            <TextBox Text="{Binding LogMessages}"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#F5F5F5"
                     Height="90"/>
        </GroupBox>
    </Grid>
</UserControl>
